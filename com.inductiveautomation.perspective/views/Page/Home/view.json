                  "code": "\t\n\tICONS \u003d {\n    \t\t\"info\":         (\"material/info\",                   \"#1E88E5\", \"Information\"),  # blue\n    \t\t\"alarm_active\": (\"material/notification_important\", \"#E53935\", \"Alarm Active\"),  # red\n    \t\t\"alarm_clear\":  (\"material/check_circle\",           \"#43A047\", \"Alarm Cleared\"),  # green\n    \t\t\"control\":      (\"material/warning\",                \"#FBC02D\", \"Control Action\"),  # amber\n\t\t}\n\t\n\tDEFAULT_ICON \u003d (\"material/help_outline\", \"#FF8C00\", \"\")\n\t\n\tcolumns \u003d system.dataset.getColumnHeaders(value)\n\tdata \u003d []\n\t\n\tfor row in range(value.getRowCount()):\n\t\t\n\t\trow_obj \u003d {}\n\t\tfor col in columns:\n\t\t\tcell \u003d {\"value\": value.getValueAt(row, col)}\n\t\t\trow_obj[col] \u003d cell\n\n\t\tcat \u003d value.getValueAt(row, \"event_category\")\n\t\tpath, color, tip \u003d ICONS.get(cat, DEFAULT_ICON)\n\t\ticon_cell \u003d {\"path\": path, \"color\": color, \"tooltip\": tip}\n\t\t\n\t\trow_obj[\"icon\"] \u003d icon_cell\n\t\t\n\t\tdata.append(row_obj)\n\t\n\treturn data",
